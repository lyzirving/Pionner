#pragma once

#include "lighting/LitDef.glslh"
#include "Surface_BRDF.glslh"

vec3 IsotropicLobe(const Light light, const PixelParams pixel) {
    float D = Distribution(pixel.roughness, light.NoH, light.H);
    float V = Visibility(pixel.roughness, light.NoV, light.NoL);
    vec3 F = Fresnel(pixel.f0, light.LoH);
    return (D * V) * F;
}

vec3 SpecularLobe(const Light light, const PixelParams pixel) {
    return IsotropicLobe(light, pixel);
}

vec3 DiffuseLobe(const Light light, const PixelParams pixel) {
    return pixel.diffuseColor * Diffuse(pixel.roughness, light.NoV, light.NoL, light.LoH);
}

#ifdef USE_CLEARCOAT
float ClearCoatLobe(const Light light, const PixelParams pixel, out float Fcc) {
    float clearCoatNoH = light.NoH;

    // clear coat specular lobe
    float D = DistributionClearCoat(pixel.clearCoatRoughness, clearCoatNoH, light.H);
    float V = VisibilityClearCoat(light.LoH);
    float F = F_Schlick(0.04, 1.0, light.LoH) * pixel.clearCoat; // fix IOR to 1.5

    Fcc = F;
    return D * V * F;
}
#endif

/**
 * Evaluates lit materials with the standard shading model. This model comprises
 * of 2 BRDFs: an optional clear coat BRDF, and a regular surface BRDF.
 *
 * Surface BRDF
 * The surface BRDF uses a diffuse lobe and a specular lobe to render both
 * dielectrics and conductors. The specular lobe is based on the Cook-Torrance
 * micro-facet model (see surface_brdf.fs for more details). In addition, the specular
 * can be either isotropic or anisotropic.
 *
 * Clear coat BRDF
 * The clear coat BRDF simulates a transparent, absorbing dielectric layer on
 * top of the surface. Its IOR is set to 1.5 (polyutherane) to simplify
 * our computations. This BRDF only contains a specular lobe and while based
 * on the Cook-Torrance microfacet model, it uses cheaper terms than the surface
 * BRDF's specular lobe (see surface_brdf.fs).
 */
vec3 SurfaceShading(const Light light, const PixelParams pixel, float occlusion) {
    if(light.NoL <= 0.0) {
        return vec3(0.0);
    }

    vec3 Fr = SpecularLobe(light, pixel);
    vec3 Fd = DiffuseLobe(light, pixel);

    vec3 color = Fd + Fr * pixel.energyCompensation;

    #ifdef USE_CLEARCOAT        
        if(pixel.clearCoat > MIN_N_DOT_V) {
            float Fcc;
            float clearCoat = ClearCoatLobe(light, pixel, Fcc);
            float attenuation = 1.0 - Fcc;
    
            color *= attenuation * light.NoL;
            
            // If the material has a normal map, we want to use the geometric normal
            // instead to avoid applying the normal map details to the clear coat layer
            float clearCoatNoL = Saturate(dot(m_ShadingNormal, light.L));
            color += clearCoat * clearCoatNoL;

            // Early exit to avoid the extra multiplication by NoL
            return (color * light.Color) * (light.Intensity * light.Attenuation * occlusion);
        }        
    #endif    

    return (color * light.Color) * (light.Intensity * light.Attenuation * light.NoL * occlusion);
}