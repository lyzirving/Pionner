#pragma once

#include "SurfaceShadow.glslh"
#include "SurfaceMaterialInputs.glslh"
#include "SurfaceShadingStandard.glslh"

layout (std140) uniform DirectionalLitBlock
{
	vec3 Direction;
    vec3 Color;
    float Intensity;
    float Bias;
    float NormalBias;
    int ShadowMode;    
    float ShadowIntensity;
    bool CastShadow;
} u_DirLit;

Light GetDirectionalLight()
{
    Light light;

    light.Color = u_DirLit.Color;
    light.Intensity = u_DirLit.Intensity;
    light.Attenuation = 1.0;

    light.L = normalize(-u_DirLit.Direction);
    light.NoV = m_ShadingNoV;
    light.NoL = max(0.0, dot(m_ShadingNormal, light.L));

    light.H = normalize(light.L + m_ShadingView);    
    light.NoH = max(0.0, dot(m_ShadingNormal, light.H));
    light.LoH = max(0.0, dot(light.L, light.H));

    light.Bias = u_DirLit.Bias;
    light.ShadowIntensity = u_DirLit.ShadowIntensity;
    light.ShadowMode = u_DirLit.ShadowMode;
    light.CastShadow = u_DirLit.CastShadow;

    return light;
}

vec3 EvaluateDirectionalLight(const MaterialInputs material, const PixelParams pixel) {
	Light light = GetDirectionalLight();
    float visibility = SurfaceDirLitShadow(light);
    return SurfaceShading(light, pixel, visibility);
}