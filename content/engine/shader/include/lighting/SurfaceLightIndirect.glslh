#pragma once

#include "lighting/IndirectLightUniforms.glslh"
#include "SurfaceMaterialInputs.glslh"
#include "Surface_BRDF.glslh"

vec3 IrradianceSH(vec3 n) {
    // uniform vec3 sphericalHarmonics[9]
    // We can use only the first 2 bands for better performance
    return
          u_IndirectLight.SphericalHarmonics[0]
        + u_IndirectLight.SphericalHarmonics[1] * (n.y)
        + u_IndirectLight.SphericalHarmonics[2] * (n.z)
        + u_IndirectLight.SphericalHarmonics[3] * (n.x)
        + u_IndirectLight.SphericalHarmonics[4] * (n.y * n.x)
        + u_IndirectLight.SphericalHarmonics[5] * (n.y * n.z)
        + u_IndirectLight.SphericalHarmonics[6] * (3.0 * n.z * n.z - 1.0)
        + u_IndirectLight.SphericalHarmonics[7] * (n.z * n.x)
        + u_IndirectLight.SphericalHarmonics[8] * (n.x * n.x - n.y * n.y);
}

vec3 PrefilteredDFG_LUT(float lod, float NoV) {
    return textureLod(u_IblDFG, vec2(NoV, lod), 0.0).rgb;
}

vec3 PrefilteredDFG(float perceptualRoughness, float NoV) {
    // PrefilteredDFG_LUT() takes a LOD, which is sqrt(roughness) = perceptualRoughness
    return PrefilteredDFG_LUT(perceptualRoughness, NoV);
}

vec3 SpecularDFG(const PixelParams pixel) {
    return mix(pixel.dfg.xxx, pixel.dfg.yyy, pixel.f0);
}

vec3 GetSpecularDominantDirection(const vec3 n, const vec3 r, float roughness) {
    return mix(r, n, roughness * roughness);
}

vec3 GetReflectedVector(const PixelParams pixel, const vec3 n) {
    return GetSpecularDominantDirection(n, m_ShadingReflected, pixel.roughness);
}

float PerceptualRoughnessToLod(float perceptualRoughness) {
    // The mapping below is a quadratic fit for log2(perceptualRoughness)+iblRoughnessOneLevel when
    // iblRoughnessOneLevel is 4. We found empirically that this mapping works very well for
    // a 256 cubemap with 5 levels used. But also scales well for other iblRoughnessOneLevel values.

    //todo
    //return frameUniforms.iblRoughnessOneLevel * perceptualRoughness * (2.0 - perceptualRoughness);
    return 4.0 * perceptualRoughness * (2.0 - perceptualRoughness);
}

vec3 PrefilteredRadiance(const vec3 r, float perceptualRoughness) {
    float lod = PerceptualRoughnessToLod(perceptualRoughness);
    return textureLod(u_IblSpecular, r, lod).rgb;
}

vec3 Irradiance_RoughnessOne(const vec3 n) {
    // note: lod used is always integer, hopefully the hardware skips tri-linear filtering
    return textureLod(u_IblSpecular, n, 0.0).rgb;
}

vec3 DiffuseIrradiance(const vec3 n) {
    // On Metal devices with certain chipsets, this light_iblSpecular texture sample must be pulled
    // outside the frameUniforms.iblSH check. This is to avoid a Metal pipeline compilation error
    // with the message: "Could not statically determine the target of a texture".
    // The reason for this is unknown, and is possibly a bug that exhibits only on these devices.
    vec3 irradianceRoughnessOne = Irradiance_RoughnessOne(n);

    ivec2 s = textureSize(u_IblSpecular, 0);
    float du = 1.0 / float(s.x);
    float dv = 1.0 / float(s.y);
    vec3 m0 = normalize(cross(n, vec3(0.0, 1.0, 0.0)));
    vec3 m1 = cross(m0, n);
    vec3 m0du = m0 * du;
    vec3 m1dv = m1 * dv;
    vec3 c;
    c  = Irradiance_RoughnessOne(n - m0du - m1dv);
    c += Irradiance_RoughnessOne(n + m0du - m1dv);
    c += Irradiance_RoughnessOne(n + m0du + m1dv);
    c += Irradiance_RoughnessOne(n - m0du + m1dv);
    return c * 0.25;
}

vec3 SimpleFilamentIBL(const MaterialInputs material, const PixelParams pixel)
{
    if(!u_IndirectLight.bValid)
        return vec3(0.0, 0.0, 0.0);

    // Specular indirect
    vec3 r = GetReflectedVector(pixel, m_ShadingNormal);
    vec3 indirectSpecular = PrefilteredRadiance(r, pixel.perceptualRoughness);
    vec2 env = PrefilteredDFG_LUT(pixel.perceptualRoughness, m_ShadingNoV).rg;
    vec3 specularColor = pixel.f0 * env.x + pixel.f90 * env.y;

    // Diffuse indirect
    // We multiply by the Lambertian BRDF to compute radiance from irradiance
    // With the Disney BRDF we would have to remove the Fresnel term that
    // depends on NoL (it would be rolled into the SH). The Lambertian BRDF
    // can be baked directly in the SH to save a multiplication here
    vec3 indirectDiffuse = max(IrradianceSH(m_ShadingNormal), 0.0) * Fd_Lambert();

    return (material.baseColor.rgb * indirectDiffuse + indirectSpecular * specularColor) * 0.1;
}

vec3 EvaluateIBL_Main(const MaterialInputs material, const PixelParams pixel) {
    // specular layer
    vec3 Fr = vec3(0.0);
    // screen-space reflections
    vec4 ssrFr = vec4(0.0);

    vec3 E = SpecularDFG(pixel);
    vec3 r = GetReflectedVector(pixel, m_ShadingNormal);
    Fr = E * PrefilteredRadiance(r, pixel.perceptualRoughness);

    vec3 diffuseIrradiance = DiffuseIrradiance(m_ShadingNormal);
    vec3 Fd = pixel.diffuseColor * diffuseIrradiance * (vec3(1.0) - E);

    return (Fr + Fd);
}

vec3 EvaluateIBL(const MaterialInputs material, const PixelParams pixel) {
    //return SimpleFilamentIBL(material, pixel);
    return EvaluateIBL_Main(material, pixel);
}