#pragma once

#include "lighting/LitDef.glslh"

struct PointLitShadowCasterAttr
{
    mat4 LitSpaceMat[POINT_LIT_DIRECTION_NUM];
    vec3 Position;    
    bool CastShadow;
};

layout (std140) uniform PointLitShadowCasterBlock
{
    // @todo:????
    // The num of PointLitShadowCasterAttr array will influence the fps
    // if POINT_LIT_LIMIT is set to be 10, and the fps is largely slowed down
    // The slow down of fps is caused by the limit of bandwidth?
    PointLitShadowCasterAttr LitAttr[POINT_LIT_LIMIT];
    float FrustumFar;
    int LitNum;	
} u_PointLitCaster;