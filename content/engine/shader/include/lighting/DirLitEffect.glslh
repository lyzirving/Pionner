#pragma once

#include "PBR.glslh"
#include "lighting/LitDef.glslh"
#include "lighting/DirLitShadowCaster.glslh"

layout (std140) uniform DirectionalLitBlock
{
	vec3 Direction;
    vec3 Color;
    float Intensity;
    float Bias;
    float NormalBias;
    int ShadowMode;    
    float ShadowIntensity;
    bool CastShadow;
} u_DirLit;

uniform sampler2D u_ShadowMap;

vec3 LitEffect_DirLit()
{
    // Negate the direction to expect a direction from the fragment towards the light source
    vec3 Li = normalize(-u_DirLit.Direction);
    vec3 Lh = normalize(Li + m_PBRParams.V);
	vec3 Lradiance = u_DirLit.Color * u_DirLit.Intensity;

    // Calculate angles between surface normal and light vector.
	float NdotL = max(0.0, dot(m_PBRParams.N, Li));
	float NdotH = max(0.0, dot(m_PBRParams.N, Lh));

    vec3  F = FresnelSchlickRoughness(max(0.0, dot(Lh, m_PBRParams.V)), m_PBRParams.F0, m_PBRParams.Roughness);
    float D = NdfGGX(NdotH, m_PBRParams.Roughness);
    float G = GaSchlickGGX(NdotL, m_PBRParams.NdotV, m_PBRParams.Roughness);

    vec3 kd = (vec3(1.0) - F) * (1.0 - m_PBRParams.Metalness);
	vec3 diffuseBRDF = kd * m_PBRParams.Albedo;

    // Cook-Torrance
	vec3 specularBRDF = (F * D * G) / max(Epsilon, 4.0 * NdotL * m_PBRParams.NdotV);
	specularBRDF = clamp(specularBRDF, vec3(0.0), vec3(10.0));
    return (diffuseBRDF + specularBRDF) * NdotL * Lradiance;
}

float DirLit_HardShadow(sampler2D shadowMap)
{
    vec4 lightSpacePos = u_DirLitShadowCaster.PrjMat * u_DirLitShadowCaster.ViewMat * vec4(m_PBRParams.FragPos, 1.f);    
    vec3 prjCoords = lightSpacePos.xyz / lightSpacePos.w;      // perform perspective divide    
    prjCoords = prjCoords * 0.5 + 0.5;                         // transform to [0,1] range    
    float currentDepth = prjCoords.z;                          // get depth of current fragment from light's perspective    
    float closestDepth = texture(shadowMap, prjCoords.xy).r;   // get closest depth value from light's perspective (using [0,1] range fragPosLight as coords)

    vec3 lightDir = normalize(-u_DirLit.Direction);
    float bias = SlopScaleBias(lightDir, m_PBRParams.N, u_DirLit.Bias); 
    return (currentDepth - bias) > closestDepth  ? 1.0 : 0.0;
}

float DirLit_PcfShadow(int radius, sampler2D shadowMap)
{   
    vec4 lightSpacePos = u_DirLitShadowCaster.PrjMat * u_DirLitShadowCaster.ViewMat * vec4(m_PBRParams.FragPos, 1.f);    
    vec3 prjCoords = lightSpacePos.xyz / lightSpacePos.w;      // perform perspective divide    
    prjCoords = prjCoords * 0.5 + 0.5;                         // transform to [0,1] range    
    float currentDepth = prjCoords.z;                          // get depth of current fragment from light's perspective        
    
    vec3 lightDir = normalize(-u_DirLit.Direction);        
    float bias = SlopScaleBias(lightDir, m_PBRParams.N, u_DirLit.Bias); 
    
    vec2 texelSize = 1.0 / textureSize(shadowMap, 0);
    int itrCnt = 0;
    float shadow = 0.f;
    //PCF
    for(int x = -radius; x <= radius; ++x)
    {
        for(int y = -radius; y <= radius; ++y)
        {
            float pcfDepth = texture(shadowMap, prjCoords.xy + vec2(x, y) * texelSize).r; 
            shadow += (currentDepth - bias > pcfDepth) ? 1.f : 0.f;  
            itrCnt++;
        }    
    }
    shadow /= float(itrCnt);

    // keep the shadow at 0.0 when outside the far plane region of the light's frustum.
    if(prjCoords.z > 1.0)
        shadow = 0.0;

    return shadow;
}

float LitEffect_DirLitShadow()
{
    if(!u_DirLit.CastShadow)
        return 1.0;

    float shadow = 0.0;
    if(u_DirLit.ShadowMode == ShadowMode_Hard)
    {
        shadow = DirLit_HardShadow(u_ShadowMap);
    }
    else if(u_DirLit.ShadowMode == ShadowMode_Soft_2X)
    {
        shadow = DirLit_PcfShadow(2, u_ShadowMap);
    }
    else if(u_DirLit.ShadowMode == ShadowMode_Soft_4X)
    {
        shadow = DirLit_PcfShadow(4, u_ShadowMap);
    }
    else
    {
        shadow = DirLit_PcfShadow(1, u_ShadowMap);
    }    
    return 1.0 - (shadow * u_DirLit.ShadowIntensity);
}