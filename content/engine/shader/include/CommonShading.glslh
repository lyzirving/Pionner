#pragma once

#include "ConstDef.glslh"
#include "Camera.glslh"

// These variables should be in a struct but some GPU drivers ignore the
// precision qualifier on individual struct members

highp vec3 m_ShadingPosition;         // position of the fragment in world space
      vec3 m_ShadingView;             // normalized vector from the fragment to the eye

vec3  m_ShadingNormal;                 // normalized transformed normal, in world space
vec3  m_ShadingReflected;              // reflection of view about normal
float m_ShadingNoV;                    // dot(normal, view), always strictly >= MIN_N_DOT_V