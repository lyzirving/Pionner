#pragma once

#include "lighting/LitDef.glslh"
#include "ShadowUniforms.glslh"
#include "CommonShading.glslh"

float SurfaceDirLitHardShadow(const Light light)
{
    vec4 lightSpacePos = u_DirLitShadowCaster.PrjMat * u_DirLitShadowCaster.ViewMat * vec4(m_ShadingPosition, 1.f);    
    vec3 prjCoords = lightSpacePos.xyz / lightSpacePos.w;      // perform perspective divide    
    prjCoords = prjCoords * 0.5 + 0.5;                         // transform to [0,1] range    
    float currentDepth = prjCoords.z;                          // get depth of current fragment from light's perspective    
    float closestDepth = texture(u_ShadowMap, prjCoords.xy).r; // get closest depth value from light's perspective (using [0,1] range fragPosLight as coords)

    float bias = SlopScaleBias(light.L, m_ShadingNormal, light.Bias); 
    return (currentDepth - bias) > closestDepth  ? 1.0 : 0.0;
}

float SurfaceDirLitPcfShadow(const Light light, int radius)
{   
    vec4 lightSpacePos = u_DirLitShadowCaster.PrjMat * u_DirLitShadowCaster.ViewMat * vec4(m_ShadingPosition, 1.f);    
    vec3 prjCoords = lightSpacePos.xyz / lightSpacePos.w;      // perform perspective divide    
    prjCoords = prjCoords * 0.5 + 0.5;                         // transform to [0,1] range    
    float currentDepth = prjCoords.z;                          // get depth of current fragment from light's perspective        
         
    float bias = SlopScaleBias(light.L, m_ShadingNormal, light.Bias); 
    
    vec2 texelSize = 1.0 / textureSize(u_ShadowMap, 0);
    int itrCnt = 0;
    float shadow = 0.f;
    //PCF
    for(int x = -radius; x <= radius; ++x)
    {
        for(int y = -radius; y <= radius; ++y)
        {
            float pcfDepth = texture(u_ShadowMap, prjCoords.xy + vec2(x, y) * texelSize).r; 
            shadow += (currentDepth - bias > pcfDepth) ? 1.f : 0.f;  
            itrCnt++;
        }    
    }
    shadow /= float(itrCnt);

    // keep the shadow at 0.0 when outside the far plane region of the light's frustum.
    if(prjCoords.z > 1.0)
        shadow = 0.0;

    return shadow;
}

float SurfaceDirLitShadow(const Light light)
{
    if(!light.CastShadow)
        return 1.0;

    float shadow = 0.0;
    if(light.ShadowMode == ShadowMode_Hard)
    {
        shadow = SurfaceDirLitHardShadow(light);
    }
    else if(light.ShadowMode == ShadowMode_Soft_2X)
    {
        shadow = SurfaceDirLitPcfShadow(light, 2);
    }
    else if(light.ShadowMode == ShadowMode_Soft_4X)
    {
        shadow = SurfaceDirLitPcfShadow(light, 4);
    }
    else
    {
        shadow = SurfaceDirLitPcfShadow(light, 1);
    }    
    return 1.0 - (shadow * light.ShadowIntensity);
}

float SurfacePointLitShadow(const Light light, const int idx)
{   
    if(!light.CastShadow)
        return 1.0;

    float shadow = 0.0;    
    vec3 lit2Frag = m_ShadingPosition - light.Position;
    float currentDepth = length(lit2Frag);
    float bias = SlopScaleBias(light.L, m_ShadingNormal, light.Bias);

    float viewDist = length(u_Camera.Position - m_ShadingPosition);
    float diskRadius = (1.0 + (viewDist / u_Camera.FrustumFar)) / 25.0;    

    for(int it = 0; it < SPL_DIR_NUM; ++it)
    {
        vec4 coord = vec4(lit2Frag + normalize(SPL_DIR[it]) * diskRadius, float(idx));
        float closestDepth = texture(u_PointLitsShadow, coord).r;
        closestDepth *= u_Camera.FrustumFar;   // undo mapping [0;1]
        if(currentDepth - bias > closestDepth)
            shadow += 1.0 * light.ShadowIntensity;
    }    
    return 1.0 - (shadow / float(SPL_DIR_NUM));
}
